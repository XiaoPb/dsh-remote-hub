{
  "name": "@xiaopb/dsh-remote-hub",
  "version": "0.3.0",
  "private": false,
  "description": "DSH dual-role remote-access plugin. One package, two Cordis entries: the host half exposes this machine behind a device-authenticated guard (QR/short-code pairing, per-device bearer tokens, roles enforced inside DSH's own decide()); the client half takes over another machine's Host by supplying the official __DSH_TRANSPORT__ (unary RPC over /remote/rpc, Remote stream mux over /remote/ws), so the sidebar, sessions and workspaces all show the remote Host.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/src/index.d.ts",
  "bin": {
    "dsh-remote-hub-pair": "bin/dsh-remote-hub-pair.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/host/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/src/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['lib','.build'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:serial": "node scripts/run-all-tests.mjs",
    "verify": "npm run typecheck && npm run build && npm run test && node scripts/version-gate.mjs && node scripts/contract-check.mjs",
    "check": "node scripts/verify-package.mjs && node scripts/run-all-tests.mjs && node scripts/version-gate.mjs && node scripts/contract-check.mjs && node scripts/fence.mjs && node scripts/redlines.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:matrix": "node scripts/render-api-matrix.mjs",
    "docs:matrix:check": "node scripts/render-api-matrix.mjs --check",
    "pack:dry": "npm pack --dry-run",
    "prepack": "node scripts/verify-package.mjs --no-pack"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-remote-access": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remote-access": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "rolldown": "1.2.18",
    "tsdown": "0.22.14",
    "typescript": "^5.9.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "bin/dsh-remote-hub-pair.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "XiaoPb",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "remote-access",
    "remote-control",
    "pairing"
  ]
}
